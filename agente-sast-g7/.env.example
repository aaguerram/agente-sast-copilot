# Copia este archivo a .env y rellena los valores. .env está en .gitignore: NO se versiona.
# El PAT es de la cuenta de Azure DevOps (distinta de la de GitHub Copilot).
# NUNCA pegues el PAT en el chat ni lo subas al repo.

# URL de la organización de Azure DevOps (la cuenta de ADO, no la de Copilot)
ADO_ORG_URL=https://dev.azure.com/TU_ORGANIZACION

# Nombre del proyecto en Azure DevOps
ADO_PROJECT=TU_PROYECTO

# Tipo de work item a crear (Bug, Issue, Task...)
ADO_WORKITEM_TYPE=Bug

# Opcionales: ruta de área e iteración si el proyecto las exige
ADO_AREA_PATH=
ADO_ITERATION_PATH=

# El token va aquí en tu .env local (o como variable secreta del pipeline). Déjalo vacío en el ejemplo.
ADO_PAT=

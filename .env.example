# Copia a .env solo si necesitas cambiar algo. Ningún valor es obligatorio:
# scripts/validar-local.(sh|ps1) y scripts/ado.(sh|ps1) detectan UID, GID y DOCKER_GID solos.
# NUNCA pongas aquí tokens ni PATs (este archivo se versiona; .env no).

# UID/GID de tu usuario para que los contenedores escriban con tus permisos (id -u / id -g)
UID=1000
GID=1000
DOCS_PORT=8300
# Carpeta de la máquina donde se guarda el sitio generado
SALIDA_DIR=./salida

# Puerto del SonarQube efímero (9000 suele estar ocupado)
SONAR_PORT=9100
# Versión de la imagen de Azure CLI que usa scripts/ado.sh
AZURE_CLI_VERSION=2.91.0
